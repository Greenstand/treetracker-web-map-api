{
  "branches": ["master"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    "@semantic-release/npm",
    [
      "@semantic-release/git",
      {
        "assets": ["docs", "package.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github",
    [
      "@semantic-release/exec",
      {
        "successCmd": "if [ -n \"$GITHUB_OUTPUT\" ]; then printf '%s\\n' 'new-release-published=true' 'new-release-version=${nextRelease.version}' 'new-release-git-tag=${nextRelease.gitTag}' >> \"$GITHUB_OUTPUT\"; fi"
      }
    ]
  ]
}
